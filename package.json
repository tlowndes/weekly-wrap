{
  "name": "weekly-wrap",
  "version": "1.0.0",
  "description": "See what you actually did this week: ticked tasks, notes and your best day, every Friday.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "vitest run",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "weekly review",
    "adhd"
  ],
  "author": "Tom Lowndes",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "22.15.0",
    "builtin-modules": "3.3.0",
    "esbuild": "0.25.0",
    "obsidian": "1.8.7",
    "tslib": "2.8.1",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
